# Example values only. Keep your real .env private.
APPDATA_ROOT=/path/to/docker/appdata
DOWNLOADS_ROOT=/path/to/downloads
IMPORT_ROOT=/path/to/completed-downloads
BOOKS_ROOT=/path/to/books
COMICS_ROOT=/path/to/comics
AUDIOBOOKS_ROOT=/path/to/audiobooks
PUID=1000
PGID=1000
TZ=Etc/UTC
# BookOrbit uses the same database password in both containers.
BOOKORBIT_APP_URL=http://nas.example.invalid:8150
BOOKORBIT_LIBRARY_ROOT=/path/to/bookorbit-library
BOOKORBIT_PUID=1000
BOOKORBIT_PGID=1000
BOOKORBIT_DB_PASSWORD=replace-with-private-database-password
BOOKORBIT_JWT_SECRET=replace-with-private-jwt-secret
BOOKORBIT_SETUP_BOOTSTRAP_TOKEN=replace-with-private-setup-token
BOOKORBIT_REQUEST_ENCRYPTION_KEY=replace-with-private-encryption-key
