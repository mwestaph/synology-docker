# Example values only. Keep your real .env private.
APPDATA_ROOT=/path/to/docker/appdata
POSTGRES_PASSWORD=replace-with-private-database-password
# Use the same password as POSTGRES_PASSWORD; URL-encode reserved characters.
DATABASE_URL=postgresql://linkwarden:replace-with-private-database-password@db:5432/linkwarden
NEXTAUTH_SECRET=replace-with-private-secret
NEXTAUTH_URL=https://linkwarden.example.invalid
