# Copy to a private .env file and replace the example values before deployment.
# Never commit .env or real credentials to the public repository.
# Use values from your VPN provider's WireGuard configuration.
WIREGUARD_PUBLIC_KEY=replace-with-server-public-key
WIREGUARD_PRIVATE_KEY=replace-with-private-key

# qBitrr credentials and API keys.
QBIT_USERNAME=replace-with-qbittorrent-username
QBIT_PASSWORD=replace-with-qbittorrent-password
SONARR_API_KEY=replace-with-private-sonarr-api-key
RADARR_API_KEY=replace-with-private-radarr-api-key
LIDARR_API_KEY=replace-with-private-lidarr-api-key
