# Example values for compose.yaml. Keep the real .env private.
# El West: these two passwords must be identical.
ELWEST_MARIADB_PASSWORD=replace-with-elwest-database-password
ELWEST_WORDPRESS_DB_PASSWORD=replace-with-elwest-database-password
ELWEST_MARIADB_ROOT_PASSWORD=replace-with-elwest-root-password
# Michael: the WordPress database password is shared with MariaDB.
MICHAEL_WORDPRESS_DB_NAME=wordpress
MICHAEL_WORDPRESS_DB_USER=wordpress
MICHAEL_WORDPRESS_DB_PASSWORD=replace-with-michael-database-password
MICHAEL_MARIADB_ROOT_PASSWORD=replace-with-michael-root-password
